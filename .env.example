NODE_ENV=development
API_PORT=3000
WEB_PORT=18081
WEB_ORIGIN=http://localhost:18081
SQLITE_PATH=.data/sengoku.sqlite
SESSION_SECRET=development-only-change-me
LOG_LEVEL=info
# Optional: enables server-side terrain generation for custom maps (fal.ai). Feature disabled
# if unset. Also used by the offline terrain-generation CLI (packages/terrain).
FAL_KEY=
# Directory for terrain pipeline outputs (intermediates + final webp). Each map gets a subdir.
# Defaults to a repo-local terrain/<mapId> dir when unset.
TERRAIN_OUT_DIR=.data/terrain-gen
